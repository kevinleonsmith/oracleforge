# ---- Chain / RPC ----
GNOSIS_RPC_URL=https://rpc.gnosischain.com
CHIADO_RPC_URL=https://rpc.chiadochain.net
DEPLOYER_PK=0x...                     # testnet key only — never commit a real key
COLLATERAL=0xe91D153E0b41518A2Ce8Dd3D7944Fa863463a97d   # WXDAI on Gnosis

# ---- Frontend (NEXT_PUBLIC_* are exposed to the browser) ----
NEXT_PUBLIC_CHAIN=chiado              # chiado | gnosis
NEXT_PUBLIC_RPC_URL=https://rpc.chiadochain.net
NEXT_PUBLIC_TABLELAND_GATEWAY=https://tableland.network
NEXT_PUBLIC_DATA_SOURCE=mock          # mock | chain  (chain = live deployed contracts)
NEXT_PUBLIC_MARKETS_TABLE=markets     # Tableland physical markets table name
# NEXT_PUBLIC_MARKET_ENGINE=0x...     # overrides deployments/chiado.json
# NEXT_PUBLIC_ORACLE_ADAPTER=0x...
# NEXT_PUBLIC_COLLATERAL=0x...

# ---- Oracle / integrations (server-side) ----
CHAINLINK_FUNCTIONS_SUB_ID=
ARWEAVE_WALLET_JSON=                  # path to Arweave keyfile for archival
LIT_NETWORK=datil-dev                 # Lit Protocol network

# ---- AI compute ----
AKASH_KEYRING_BACKEND=os
HF_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Relayer (notices -> createMarket) ----
RELAYER_RPC_URL=https://rpc.chiadochain.net
RELAYER_PK=0x...                      # must be an authorized relayer on the engine
MARKET_ENGINE_ADDRESS=0x...           # from the contracts deploy
RELAYER_NOTICE_SOURCE=stub            # stub | graphql
CARTESI_GRAPHQL_URL=http://localhost:8080/graphql
# ORACLEFORGE_FEEDS={"EUR/USD":"0x...","ECON/CPI":"0x..."}   # real feed addresses

# ---- Resolution watcher (poke resolve() after close) ----
RESOLVER_RPC_URL=https://rpc.chiadochain.net
RESOLVER_PK=0x...                     # funded key; needs gas only (resolve is permissionless)
# ORACLE_ADAPTER_ADDRESS=0x...        # optional; else read from engine.oracle()
MARKETS_TABLE=markets                 # Tableland physical table name (e.g. markets_10200_123)
RESOLVER_INTERVAL=30                  # seconds between ticks in --watch

# ---- Arweave archival worker ----
ARWEAVE_BACKEND=local                 # local | turbo
ARWEAVE_LOCAL_STORE=./.arweave-store  # content-addressed dir store (local backend)
ARWEAVE_GATEWAY=https://arweave.net/
ARWEAVE_WALLET_JSON=                  # path to JWK keyfile (turbo backend)
ARCHIVER_TABLELAND_WRITEBACK=false    # write arweave_tx back to Tableland rows
