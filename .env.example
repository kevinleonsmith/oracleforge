# ---- Chain / RPC ----
GNOSIS_RPC_URL=https://rpc.gnosischain.com
CHIADO_RPC_URL=https://rpc.chiadochain.net
DEPLOYER_PK=0x...                     # testnet key only — never commit a real key
COLLATERAL=0xe91D153E0b41518A2Ce8Dd3D7944Fa863463a97d   # WXDAI on Gnosis

# ---- Frontend (NEXT_PUBLIC_* are exposed to the browser) ----
NEXT_PUBLIC_CHAIN=chiado              # chiado | gnosis
NEXT_PUBLIC_RPC_URL=https://rpc.chiadochain.net
NEXT_PUBLIC_TABLELAND_GATEWAY=https://tableland.network

# ---- Oracle / integrations (server-side) ----
CHAINLINK_FUNCTIONS_SUB_ID=
ARWEAVE_WALLET_JSON=                  # path to Arweave keyfile for archival
LIT_NETWORK=datil-dev                 # Lit Protocol network

# ---- AI compute ----
AKASH_KEYRING_BACKEND=os
HF_MODEL=sentence-transformers/all-MiniLM-L6-v2
